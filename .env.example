# Research Radar environment variables

# Copy this file to `.env` and fill in at least one LLM provider key.

# ---- Database ----
# Default: sqlite:///data/research_radar.db
# DATABASE_URL=sqlite:///data/research_radar.db

# ---- Runtime ----
# Daily report, Dashboard date filters, and default daily-refresh dates use this timezone.
# RESEARCH_RADAR_TIMEZONE=Asia/Shanghai

# ---- LLM Providers (configure at least one) ----

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1/responses
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_STANDARD=gpt-5.2
# OPENAI_MODEL_PREMIUM=gpt-5.4
# Optional for OpenAI-compatible gateways that expose /v1/responses with streaming only.
# OPENAI_INPUT_AS_LIST=true
# OPENAI_STREAM=true
# OPENAI_STORE=false
# OPENAI_OMIT_GENERATION_PARAMS=true

# Browser-use conference crawlers
# browser-use currently uses OpenAI-compatible /v1/chat/completions.
# If OPENAI_BASE_URL points directly to /v1/responses, set this separately.
# BROWSER_USE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# BROWSER_USE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# BROWSER_USE_MODEL=qwen-vl-max
# BROWSER_USE_HEADLESS=true
# BROWSER_USE_MAX_FAILURES=2
# BROWSER_USE_MAX_STEPS=5
# BROWSER_USE_LLM_MAX_RETRIES=1

# Official Black Hat schedule parser fallback.
# Only export a scoped blackhat.com cookie when the CLI receives HTTP 403
# but your browser can view the official schedule page.
# Do not paste analytics/ads cookies; cf_clearance is usually enough.
# BLACKHAT_COOKIE=cf_clearance=xxxxxxxxxxxxxxxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_STANDARD=claude-sonnet-4-6
# ANTHROPIC_MODEL_PREMIUM=claude-opus-4-6

# Gemini
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_MODEL_FAST=gemini-2.5-flash
# GEMINI_MODEL_STANDARD=gemini-2.5-pro
# GEMINI_MODEL_PREMIUM=gemini-3-pro-preview

# ---- Academic personalization ----
# Option A: Better CSL JSON exported from Zotero / Better BibTeX.
# ZOTERO_CSL_JSON=/absolute/path/to/zotero-better-csl.json

# Option B: Zotero Web API or local API.
# For Web API, use https://api.zotero.org and set either user or group id.
# For local Zotero API, set ZOTERO_API_BASE_URL=http://127.0.0.1:23119/api and ZOTERO_USER_ID=0.
# ZOTERO_API_BASE_URL=https://api.zotero.org
# ZOTERO_USER_ID=123456
# ZOTERO_GROUP_ID=123456
# ZOTERO_COLLECTION_KEY=
# ZOTERO_MAX_ITEMS=2000
# ZOTERO_API_KEY=

# Optional local CSRankings CSV cache. If unset, academic-filter tries the public GitHub CSV URL.
# CSRANKINGS_CSV=/absolute/path/to/csrankings.csv
# CSRANKINGS_URL=https://raw.githubusercontent.com/emeryberger/CSRankings/gh-pages/csrankings.csv
